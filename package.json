{
  "name": "targomo-playwright",
  "version": "1.0.0",
  "description": "Playwright E2E tests for the Targomo POI (points of interest) map application",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TarasovArtem/TargomoPlaywright.git"
  },
  "author": "Artem Tarasov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TarasovArtem/TargomoPlaywright/issues"
  },
  "homepage": "https://github.com/TarasovArtem/TargomoPlaywright#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
